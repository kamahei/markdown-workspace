{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vitest/globals"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints/**/*",
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "*.ts",
    "*.mts"
  ],
  "exclude": ["node_modules", ".output"]
}
